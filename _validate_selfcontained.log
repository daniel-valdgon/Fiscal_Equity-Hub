 38.         gen category = "CAT_NA"
 39.         gen povertyline = "PL_NONE_N"
 40.         gen pension = "PEN_PDI"
 41. 
.         sort partition variable
 42.         tempfile old_`indicator'
 43.         save `old_`indicator''
 44. }
