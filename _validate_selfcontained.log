. di as txt "--- Running NEW method ---"
--- Running NEW method ---

. 
. use `wide_input', clear

. cap frame drop fr_wide_new

. frame copy default fr_wide_new, replace
(note: frame fr_wide_new not found)

. 
. foreach indicator in share uinc cinc cov abs {
  2. 
.         // Decile
.         cap frame drop fr_dec
  3.         frame copy fr_wide_new fr_dec
  4.         frame fr_dec {
  5.                 drop `y'_millile_pc `y'_centile_pc
  6.                 groupfunction [aw=_wt], mean(`indicator'*) by(`y'_decile_p
> c)
  7.                 reshape long `indicator'_, i(`y'_decile_pc) j(variable) st
> ring
  8.                 tostring `y'_decile_pc, gen(partition) format(%04.0f)
  9.                         replace partition = "pv_dc_" + partition
 10.                         drop `y'_decile_pc
 11.                 rename `indicator'_ value
 12.         }
 13. 
.         // Centile
.         cap frame drop fr_cent
 14.         frame copy fr_wide_new fr_cent
 15.         frame fr_cent {
 16.                 drop `y'_millile_pc `y'_decile_pc
 17.                 groupfunction [aw=_wt], mean(`indicator'*) by(`y'_centile_
> pc)
 18.                 reshape long `indicator'_, i(`y'_centile_pc) j(variable) s
> tring
 19.                 tostring `y'_centile_pc, gen(partition) format(%04.0f)
 20.                         replace partition = "pv_pc_" + partition
 21.                         drop `y'_centile_pc
 22.                 rename `indicator'_ value
 23.         }
 24. 
.         // Millile
.         cap frame drop fr_mill
 25.         frame copy fr_wide_new fr_mill
 26.         frame fr_mill {
 27.                 drop `y'_centile_pc `y'_decile_pc _wt
 28.                 reshape long `indicator'_, i(`y'_millile_pc) j(variable) s
> tring
 29.                 tostring `y'_millile_pc, gen(partition) format(%04.0f)
 30.                         replace partition = "pv_pm_" + partition
 31.                         drop `y'_millile_pc
 32.                 rename `indicator'_ value
 33.         }
 34. 
.         // Combine
.         tempfile _tf_dec _tf_cent _tf_mill
 35.         frame fr_dec:  save `_tf_dec'
 36.         frame fr_cent: save `_tf_cent'
 37.         frame fr_mill: save `_tf_mill'
 38.         
.         use `_tf_mill', clear
 39.         append using `_tf_dec'
 40.         append using `_tf_cent'
 41.         cap frame drop fr_dec fr_cent fr_mill
 42. 
.         gen indicator_name = "`indicator'"
 43.         gen income = "`y'"
 44.         gen instrument = variable
 45.         gen category = "CAT_NA"
 46.         gen povertyline = "PL_NONE_N"
 47.         gen pension = "PEN_PDI"
 48. 
.         sort partition variable
 49.         tempfile new_`indicator'
 50.         save `new_`indicator''
 51. }
