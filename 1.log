. *============================================================================
> *
. *--->   B. Detecting microdata 
. *============================================================================
> *
. 
. * This code explore all subfolders available within each folder and search fo
> ll
. * all dta files in there. It create asserts that the dta files have the same 
> naming
. * structure namely. It saves a global that 
. 
. *---> B.1 Identify each dataset 
.         global n_datasets 0

. 
. local dirs1 : dir `"${microdata}"' dirs "*"

. 
. foreach subf of local dirs1 {
  2.     local cty : di strupper("`subf'")
  3.     local cty_path `"${microdata}/`subf'"'
  4.     local cty_count 0
  5.     local dirs2 : dir `"`cty_path'"' dirs "*"
  6. 
.     foreach subf2 of local dirs2 {
  7.         * Fixed structure: CountryName/dataname/HFMD/dataname.dta
.         local hfmd_path `"`cty_path'/`subf2'/HFMD"'
  8.         local f_upper : di strupper("`subf2'")
  9.         local files : dir `"`hfmd_path'"' files "*.dta"
 10. 
.         foreach f of local files {
 11.             local f_upper : di strupper("`f'")
 12.             local cty_count = `cty_count' + 1
 13.             global n_datasets   = ${n_datasets} + 1
 14.             global path_${n_datasets}  `"`hfmd_path'/`f_upper'"'
 15.             global cty_${n_datasets}   "`cty'_`cty_count'" // * @jmmonroyb
> , names for each country shoudl use database id SEN_S2022_P2022, so we avoid 
> Senegal_2 that when this is scaled up create confusions 
 16.             global fname_${n_datasets} "`f_upper'"
 17.         }
 18.     }
 19. }

. 
. *============================================================================
> ===
. *---> C. Netcash Position for ymp and yd.
. *        Generating incidence (relative) by decil (pre-fiscal and disposable)
. *============================================================================
> ===
. 
. 
. * Loop over each country:
. * @jmmonroyb, final do-file that will be used by country economist should not
>  include this loop as they will have one country. So we need to ensure smooth
>  tranistion and less loop dependent as poosible 
. 
. 
. forvalues i = 1/$n_datasets {
  2.     
.         * globals to call dataset and define the spreadsheet name .
.         global sheetname    "${cty_`i'}"
  3.     global datasetname  "${fname_`i'}"
  4.         global indivname "d_`i'" // @jmmonroyb, do we need this? 
  5.     di "Processing: ${path_`i'} - Sheet: ${sheetname}"
  6. 
.     use `"${path_`i'}"', clear
  7. 
.         *@jmmonroyb should go here adapted to official income aggregate  
.         *Create bin partitions
.         foreach bins in deciles centile millile {
  8.         cap noisily drop *`bins'_pc* 
  9.         }
 10. 
. 
. 
.         set seed 80292367
 11.         local i=0
 12.     foreach y in ymp yd {
 13.                 local ++i
 14.                 
.                 quantiles `y'_pc [w=pondih], gen(`y'_millile_pc) nq(1000) sta
> ble
 15.                 gen `y'_centile_pc = ceil(`y'_millile_pc / 10)
 16.                 gen `y'_decile_pc  = ceil(`y'_millile_pc / 100)
 17.         dis "`i' bins for `y' (millile → centile → decile)"
 18.     }
 19.         
.         tempfile output
 20.         save `output', replace 
 21. 
.         * Note on bins: bins are created in the code to ensure consistent con
> struction across countries.
.         *               quantiles correct (in a different way) than _ebin by 
> ties between observations when defining the different bins. 
.         *      _ebin include the boundary observation above. This implies som
> e mmistmatches, more in larger datasets like COL (66 mistmacthces)
.         
. *------------------------------Indicators -----------------------------------
> ---------
. *---> C.1 Estimate indicators by different income concepts and deciles
.         foreach y in ymp yd {
 22. 
.                 u `output', clear       
 23.                 keep hhid `concs_pc' pondih *_centile_pc *_decile_pc *_mil
> lile_pc
 24. 
.                 *Tax net cash as negative positions
.                 foreach x in `tax' `indtax'  {
 25.                 gen share_`x'_pc= -`x'_pc/ `y'_pc // @jmmonroyb, before do
> ing this is important a assert in previos sections that there are not missing
>  values
 26.                 }
 27. 
.                 *Transfers as positive positions
.                 foreach x in `transfer' `inkind' `Subsidies' {
 28.                         gen share_`x'_pc= `x'_pc/ `y'_pc
 29.                 }
 30. 
.                 keep `y'_millile_pc share* pondih       
 31. 
.                 * --- Single pass: millile-level weighted means (only full-da
> ta operation) ---
.                 groupfunction [aw=pondih], mean(share*) by(`y'_millile_pc)
 32. 
.                 * Derive centile/decile from millile (guaranteed perfect nest
> ing)
.                 gen `y'_centile_pc = ceil(`y'_millile_pc / 10)
 33.                 gen `y'_decile_pc  = ceil(`y'_millile_pc / 100)
 34.                 gen _wt = 1  // equal weight per millile (each has ~same p
> op by construction)
 35. 
.                 * Store millile-wide data in frame (1000 rows, for centile/de
> cile derivation)
.                 cap frame drop fr_wide
 36.                 frame copy default fr_wide, replace
 37. 
.                 * --- Millile level: reshape to long ---
.                 drop `y'_centile_pc `y'_decile_pc _wt
 38.                 reshape long share_, i(`y'_millile_pc) j(variable) string
 39.                         gen measure = "netcash_`y'_millile"
 40.                         rename share_ value
 41.                         tostring `y'_millile_pc, gen(partition) format(%04
> .0f)
 42.                         replace partition = "pv_pm_" + partition
 43.                         drop `y'_millile_pc
 44.                 cap frame drop fr_mill
 45.                 frame copy default fr_mill, replace
 46. 
.                 * --- Centile level (aggregate 10 millile means → 1 centile, 
> weighted) ---
.                 frame copy fr_wide default, replace
 47.                 drop `y'_millile_pc `y'_decile_pc
 48.                 groupfunction [aw=_wt], mean(share*) by(`y'_centile_pc)
 49.                 reshape long share_, i(`y'_centile_pc) j(variable) string
 50.                         gen measure = "netcash_`y'_centile"
 51.                         rename share_ value
 52.                         tostring `y'_centile_pc, gen(partition) format(%04
> .0f)
 53.                         replace partition = "pv_pc_" + partition
 54.                         drop `y'_centile_pc
 55.                 cap frame drop fr_cent
 56.                 frame copy default fr_cent, replace
 57. 
.                 * --- Decile level (aggregate 100 millile means → 1 decile, w
> eighted) ---
.                 frame copy fr_wide default, replace
 58.                 drop `y'_millile_pc `y'_centile_pc
 59.                 groupfunction [aw=_wt], mean(share*) by(`y'_decile_pc)
 60.                 reshape long share_, i(`y'_decile_pc) j(variable) string
 61.                         gen measure = "netcash_`y'_decile"
 62.                         rename share_ value
 63.                         tostring `y'_decile_pc, gen(partition) format(%04.
> 0f)
 64.                         replace partition = "pv_dc_" + partition
 65.                         drop `y'_decile_pc
 66. 
.                 * --- Combine all levels (from frames, no disk I/O) ---
.                 tempfile _tf_cent _tf_mill
 67.                 frame fr_cent: save `_tf_cent'
 68.                 frame fr_mill: save `_tf_mill'
 69.                 append using `_tf_cent'
 70.                 append using `_tf_mill'
 71. 
.                 * Cleanup frames
.                 frame drop fr_wide
 72.                 frame drop fr_mill
 73.                 frame drop fr_cent
 74. 
. 
.         *---> C.2 Generate decomposition by taxonomy items (3 levels)
.                 gen indicator ="incidence" 
 75.                 gen income="`y'"
 76.                 gen instrument=variable
 77. 
.                 save "$dataaux/netcash_`y'", replace 
 78. 
.         }
 79. 
. }
